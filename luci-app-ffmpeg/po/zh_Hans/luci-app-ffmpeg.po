msgstr "ffmpeg 可执行文件的绝对路径。"

msgid "Each task is started from this directory."
msgstr "每个任务都在该目录下启动。"

msgid "Enable FFmpeg management"
msgstr "启用 FFmpeg 管理"

msgid "FFmpeg Settings"
msgstr "FFmpeg 设置"

msgid "FFmpeg binary"
msgstr "FFmpeg 可执行文件"

msgid "Global settings"
msgstr "全局设置"

msgid "Global settings shared by every task."
msgstr "所有任务共用的全局设置。"

msgid "Log directory"
msgstr "日志目录"

msgid "One <section>.log file is written per task."
msgstr "每个任务对应一个 <section>.log 日志文件。"

msgid "When disabled, no task is started on boot."
msgstr "关闭后，开机时不会启动任何任务。"

