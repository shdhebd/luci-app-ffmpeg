#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# ffmpeg-ctl - luci-app-ffmpeg 的任务控制脚本
#
# 用法:
#   ffmpeg-ctl start   <section>   启动单个任务
#   ffmpeg-ctl stop    <section>   停止单个任务
#   ffmpeg-ctl restart <section>   重启单个任务
#   ffmpeg-ctl stopall             停止全部任务
#   ffmpeg-ctl autostart           启动所有 autostart=1 的任务（开机时调用）
#   ffmpeg-ctl status  <section>   输出 running / stopped
#
# 约定:
#   运行时 PID  -> /var/run/ffmpeg/<section>.pid（两行: PID、启动时间戳）
#   任务日志    -> <logdir>/<section>.log（每次启动前轮转一次为 .log.1）

. /lib/functions.sh

# 本脚本由 rpcd/ubus 调用，显式固定 PATH，避免继承到意外的搜索路径
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

RUN_DIR="/var/run/ffmpeg"
DEFAULT_LOG_DIR="/var/log/ffmpeg"
DEFAULT_WORK_DIR="/tmp/ffmpeg"
DEFAULT_BINARY="/usr/bin/ffmpeg"

# ---------------------------------------------------------------------------
# 工具函数
# ---------------------------------------------------------------------------

# section 名只允许字母、数字和下划线，防止路径穿越（如 ../../etc/xxx）
valid_section() {
	case "$1" in
		''|*[!A-Za-z0-9_]*) return 1 ;;
	esac
	return 0
}

read_pid() {
	local __pid
	[ -f "$RUN_DIR/$1.pid" ] || return 0
	read -r __pid < "$RUN_DIR/$1.pid" 2>/dev/null
	echo "$__pid"
}

# 上一次运行的退出码（由包装进程在 ffmpeg 结束后写入）
read_exit_code() {
	local __rc
	[ -f "$RUN_DIR/$1.exit" ] || return 0
	read -r __rc < "$RUN_DIR/$1.exit" 2>/dev/null
	echo "$__rc"
}

is_running() {
	local __pid
	__pid="$(read_pid "$1")"
	[ -n "$__pid" ] || return 1
	[ -d "/proc/$__pid" ] || return 1

	# 关键：确认这个 PID 确实还是我们的 ffmpeg。
	# PID 会被内核复用，若只判断「进程存在」，残留的 PID 文件
	# 可能指向已被回收并重新分配给其它守护进程（如 rpcd）的号，
	# 那样 kill 就会误杀无关进程。
	grep -qa 'ffmpeg' "/proc/$__pid/cmdline" 2>/dev/null || return 1

	return 0
}

# ---------------------------------------------------------------------------
# 启动 / 停止
# ---------------------------------------------------------------------------

start_task() {
	local section="$1" binary workdir logdir
	local input output vcodec video_bitrate acodec audio_bitrate
	local scale fps format loglevel extra overwrite
	local logfile pidfile

	is_running "$section" && return 0

	config_get binary globals binary "$DEFAULT_BINARY"
	config_get workdir globals workdir "$DEFAULT_WORK_DIR"
	config_get logdir globals logdir "$DEFAULT_LOG_DIR"
	[ -n "$binary" ]  || binary="$DEFAULT_BINARY"
	[ -n "$workdir" ] || workdir="$DEFAULT_WORK_DIR"
	[ -n "$logdir" ]  || logdir="$DEFAULT_LOG_DIR"

	config_get      input         "$section" input
	config_get      output        "$section" output
	config_get      vcodec        "$section" video_codec
	config_get      video_bitrate "$section" video_bitrate
	config_get      acodec        "$section" audio_codec
	config_get      audio_bitrate "$section" audio_bitrate
	config_get      scale         "$section" scale
	config_get      fps           "$section" fps
	config_get      format        "$section" format
	config_get      loglevel      "$section" loglevel warning
	config_get      extra         "$section" extra_args
	config_get_bool overwrite     "$section" overwrite 1

	if [ -z "$input" ] || [ -z "$output" ]; then
		logger -t ffmpeg-ctl "task '$section' not started: input or output is empty"
		return 1
	fi

	mkdir -p "$workdir" "$logdir" "$RUN_DIR" 2>/dev/null

	logfile="$logdir/$section.log"
	pidfile="$RUN_DIR/$section.pid"

	# 清掉上一次的退出码，避免前端读到陈旧结果
	rm -f "$RUN_DIR/$section.exit" 2>/dev/null

	# 每次启动轮转日志，保证 Web 界面读取的日志不会无限增长
	[ -f "$logfile" ] && mv -f "$logfile" "$logfile.1" 2>/dev/null

	(
		cd "$workdir" 2>/dev/null || cd /tmp

		set -- -hide_banner -nostdin

		[ -n "$loglevel" ] && set -- "$@" -loglevel "$loglevel"

		if [ "$overwrite" = "1" ]; then
			set -- "$@" -y
		else
			set -- "$@" -n
		fi

		set -- "$@" -i "$input"

		if [ "$vcodec" = "none" ]; then
			set -- "$@" -vn
		elif [ -n "$vcodec" ]; then
			set -- "$@" -c:v "$vcodec"
		fi

		[ -n "$video_bitrate" ] && set -- "$@" -b:v "$video_bitrate"

		if [ "$acodec" = "none" ]; then
			set -- "$@" -an
		elif [ -n "$acodec" ]; then
			set -- "$@" -c:a "$acodec"
		fi

		[ -n "$audio_bitrate" ] && set -- "$@" -b:a "$audio_bitrate"
		[ -n "$scale" ]         && set -- "$@" -vf "scale=$scale"
		[ -n "$fps" ]           && set -- "$@" -r "$fps"

		# 额外参数按空格拆分，供用户追加自定义选项
		if [ -n "$extra" ]; then
			# shellcheck disable=SC2086
			set -- "$@" $extra
		fi

		[ -n "$format" ] && set -- "$@" -f "$format"

		set -- "$@" "$output"

		# 在包装进程里跑 ffmpeg，这样能 wait 到它的退出码。
		# 用 exec 的话 PID 更直观，但父进程一退出就再也拿不到退出码了，
		# 前端只能靠猜日志判断成败——那正是「失败却报成功」的根源。
		"$binary" "$@" >>"$logfile" 2>&1 &
		ffpid=$!
		echo "$ffpid" > "$pidfile"
		date +%s >> "$pidfile" 2>/dev/null

		wait "$ffpid"
		ffrc=$?
		echo "$ffrc" > "$RUN_DIR/$section.exit" 2>/dev/null
		rm -f "$pidfile" 2>/dev/null
	) &

	# 等包装进程把 ffmpeg 的 PID 写进 pid 文件
	local i=0
	while [ "$i" -lt 10 ] && [ ! -f "$pidfile" ]; do
		sleep 1
		i=$((i + 1))
	done

	# 给进程一点时间确认是否真正起来了
	sleep 1
	if is_running "$section"; then
		logger -t ffmpeg-ctl "task '$section' started (pid $(read_pid "$section"))"
		return 0
	fi

	# 进程已经退出：读包装进程写下的真实退出码。
	# 不再用 wait，因为 ffmpeg 现在是包装进程的子进程，不是本进程的。
	local rc
	rc="$(read_exit_code "$section")"

	if [ "$rc" = "0" ]; then
		logger -t ffmpeg-ctl "task '$section' finished (exit 0)"
		return 0
	fi

	logger -t ffmpeg-ctl "task '$section' failed (exit ${rc:-unknown}), see $logfile"
	# 把失败原因回显给调用方（LuCI 会展示在通知里）
	[ -f "$logfile" ] && tail -n 15 "$logfile" 2>/dev/null
	return 1
}

stop_task() {
	local section="$1" pid i=0

	pid="$(read_pid "$section")"

	# 必须用 is_running 而不是 kill -0：只有确认该 PID 仍是我们的 ffmpeg 才敢发信号
	if is_running "$section"; then
		kill -TERM "$pid" 2>/dev/null
		while [ "$i" -lt 5 ] && is_running "$section"; do
			sleep 1
			i=$((i + 1))
		done
		if is_running "$section"; then
			kill -KILL "$pid" 2>/dev/null
		fi
		logger -t ffmpeg-ctl "task '$section' stopped (pid $pid)"
	fi

	rm -f "$RUN_DIR/$section.pid"
	return 0
}

restart_task() {
	stop_task "$1"
	config_load ffmpeg
	start_task "$1"
}

# ---------------------------------------------------------------------------
# 批量操作
# ---------------------------------------------------------------------------

stopall() {
	config_load ffmpeg
	config_foreach stop_task task
	return 0
}

autostart_task() {
	local section="$1" enabled auto
	config_get_bool enabled "$section" enabled 1
	config_get_bool auto    "$section" autostart 0
	[ "$enabled" -eq 1 ] || return 0
	[ "$auto" -eq 1 ] || return 0
	start_task "$section"
}

autostart() {
	local enabled
	config_load ffmpeg
	config_get_bool enabled globals enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_foreach autostart_task task
	return 0
}

# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

# 需要 section 参数的命令统一先做白名单校验
case "$1" in
	start|stop|restart|status)
		valid_section "$2" || { echo "invalid section name" >&2; exit 1; }
		;;
esac

case "$1" in
	start)
		[ -n "$2" ] || { echo "usage: $0 start <section>" >&2; exit 1; }
		config_load ffmpeg
		start_task "$2"
		;;
	stop)
		[ -n "$2" ] || { echo "usage: $0 stop <section>" >&2; exit 1; }
		stop_task "$2"
		;;
	restart)
		[ -n "$2" ] || { echo "usage: $0 restart <section>" >&2; exit 1; }
		restart_task "$2"
		;;
	stopall)
		stopall
		;;
	autostart)
		autostart
		;;
	status)
		[ -n "$2" ] || { echo "usage: $0 status <section>" >&2; exit 1; }
		if is_running "$2"; then
			echo "running"
		else
			echo "stopped"
		fi
		;;
	probe)
		# 探测一个媒体文件的流编码，并实测本机能否解码它。
		#
		# 「能否解码」必须实测而不是查解码器列表：h264 这类编码器在列表里
		# 可能只有 *_v4l2m2m 硬件实现，而没有 v4l2 设备节点的机器（虚拟机、
		# 多数 x86）一解码就失败。实测一次能直接给出对当前文件可用的结论。
		[ -n "$2" ] || { echo "usage: $0 probe <path>" >&2; exit 1; }
		probe_path="$2"

		# 只允许探测上传目录下的文件，避免被用来读取任意文件的信息
		case "$probe_path" in
			/tmp/*) ;;
			*) echo "invalid path" >&2; exit 1 ;;
		esac

		[ -f "$probe_path" ] || { echo "missing" >&2; exit 1; }

		config_load ffmpeg
		config_get binary globals binary "$DEFAULT_BINARY"
		[ -n "$binary" ] || binary="$DEFAULT_BINARY"

		"$binary" -hide_banner -i "$probe_path" 2>&1 |
			sed -n 's/.*Stream #0:[0-9]*.*: Video: \([A-Za-z0-9_]*\).*/V \1/p;
			        s/.*Stream #0:[0-9]*.*: Audio: \([A-Za-z0-9_]*\).*/A \1/p'

		# 只解一帧，足够判断解码链路是否可用，代价很小
		if "$binary" -hide_banner -loglevel error -nostdin \
			-i "$probe_path" -frames:v 1 -f null - >/dev/null 2>&1; then
			echo "D yes"
		else
			echo "D no"
		fi
		;;
	show)
		# 输出某段在 /etc/config/ffmpeg 里的真实内容。
		# 前端用它做诊断：LuCI 的 uci 缓存和落盘内容可能不一致，
		# 只有读文件才能确认参数到底有没有写进去。
		[ -n "$2" ] || { echo "usage: $0 show <section>" >&2; exit 1; }
		uci show "ffmpeg.$2" 2>/dev/null
		;;
	encoders)
		# 输出 ffmpeg 支持的编码器列表（原始文本，由调用方解析）
		config_load ffmpeg
		config_get binary globals binary "$DEFAULT_BINARY"
		[ -n "$binary" ] || binary="$DEFAULT_BINARY"
		"$binary" -hide_banner -encoders 2>/dev/null
		;;
	probe-codecs)
		# 逐个「真跑一次」测试编码器是否可用。
		#
		# 只看 -encoders 列表是不够的：h264_v4l2m2m / hevc_v4l2m2m 会出现在
		# 列表里，但在没有 v4l2 设备节点的机器（虚拟机、多数 x86）上
		# 一编码就报 "Could not find a valid device"。
		# 这里对每个候选做一次 0.1 秒的极短编码，只有真正跑通的才输出。
		config_load ffmpeg
		config_get binary globals binary "$DEFAULT_BINARY"
		[ -n "$binary" ] || binary="$DEFAULT_BINARY"

		for enc in libx264 libx265 h264_v4l2m2m hevc_v4l2m2m \
		           mpeg4 mpeg2video mpeg1video h263 mjpeg ffv1 prores \
		           libvpx libvpx-vp9; do
			if "$binary" -hide_banner -loglevel error -nostdin \
				-f lavfi -i color=c=black:s=64x64:d=0.1 \
				-c:v "$enc" -frames:v 1 -f null - >/dev/null 2>&1; then
				echo "V $enc"
			fi
		done

		for enc in aac libfdk_aac libmp3lame ac3 eac3 libopus libvorbis flac mp2; do
			if "$binary" -hide_banner -loglevel error -nostdin \
				-f lavfi -i anullsrc=r=44100:cl=mono:d=0.1 \
				-c:a "$enc" -frames:a 1 -f null - >/dev/null 2>&1; then
				echo "A $enc"
			fi
		done
		;;
	*)
		echo "usage: $0 {start|stop|restart|stopall|autostart|status|show|probe|encoders|probe-codecs} [arg]" >&2
		exit 1
		;;
esac

exit $?
