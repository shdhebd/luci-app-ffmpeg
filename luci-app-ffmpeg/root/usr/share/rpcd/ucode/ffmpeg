#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
//
// luci-app-ffmpeg - rpcd/ubus 后端。
//
// rpcd 会加载 /usr/share/rpcd/ucode/ 下的所有常规文件，脚本顶层返回的字典
// 描述要注册的 ubus 对象。层级结构是：
//
//     顶层键      -> ubus 对象名        （这里是 ffmpeg）
//     第二层键    -> 该对象的方法名     （status / log / control）
//     第三层      -> 方法定义字典       （{ call: fn, args: {...} }）
//
// 方法:
//     status()                 -> { "<section>": { running, pid, started } }
//     log(section, lines)      -> { section, lines: [ ... ], truncated }
//     control(action, section) -> { ok, code, output, running }
//
// 本脚本只做三件事: 读运行时状态、读日志尾部、把启停命令转发给
// /usr/libexec/ffmpeg-ctl。所有 ffmpeg 参数的拼装都在 shell 侧完成。

'use strict';

import { cursor } from 'uci';

const fs = require('fs');

const CTL = '/usr/libexec/ffmpeg-ctl';
const RUN_DIR = '/var/run/ffmpeg';
const LOG_DIR = '/var/log/ffmpeg';

// 单次最多读取 256 KiB 日志，避免超大文件吃满内存
const LOG_READ_LIMIT = 262144;
const MAX_LOG_LINES = 2000;

// ---------------------------------------------------------------------------
// 辅助函数
// ---------------------------------------------------------------------------

// rpcd 的 args 类型策略已经保证 section 是字符串，这里只做字符集白名单，
// 用于阻止路径穿越（ffmpeg-ctl 侧还会再校验一次）。
function valid_section(section) {
	if (section == null || length(section) == 0)
		return false;

	return match(section, /^[A-Za-z0-9_]+$/) ? true : false;
}

// PID 文件为两行: 第一行 PID，第二行启动时间戳（epoch 秒）。
// 两者都按字符串返回，由前端负责换算，避免在 ucode 侧做数字解析。
function read_pidfile(section) {
	if (!valid_section(section))
		return null;

	let path = RUN_DIR + '/' + section + '.pid';
	let f = fs.open(path, 'r');

	if (!f)
		return null;

	let lines = [];

	// 注意: ucode 的 read('line') 在 EOF 时返回空字符串，读取出错时返回 null
	for (let line = f.read('line'); line != null && length(line) > 0; line = f.read('line')) {
		let v = trim(line);

		if (length(v) > 0)
			push(lines, v);
	}

	f.close();

	if (length(lines) == 0)
		return null;

	// 进程已消失则视为未运行，并顺手清理残留的 PID 文件
	if (!fs.stat('/proc/' + lines[0])) {
		fs.unlink(path);
		return null;
	}

	return {
		pid: lines[0],
		started: length(lines) > 1 ? lines[1] : ''
	};
}

function exec_ctl(action, section) {
	// 注意: 这里必须用字符串形式调用 popen。
	// 部分 OpenWrt 版本（如 24.10 自带的 ucode 2025.07.18）不支持数组参数形式，
	// 传数组会直接返回 null。
	//
	// 走 shell 是安全的：action 已经过下面的 switch 白名单，
	// section 已经过 valid_section() 的 ^[A-Za-z0-9_]+$ 校验，
	// 且 ffmpeg-ctl 内部还会再校验一次。
	let cmd = CTL + ' ' + action;

	if (section)
		cmd += ' ' + section;

	let p = fs.popen(cmd + ' 2>&1');

	if (!p)
		return { code: null, output: 'cannot execute ' + CTL };

	let out = p.read('all');
	let code = p.close();

	return {
		code: code,
		output: out != null ? trim(out) : ''
	};
}

function read_log(section, n) {
	let path = LOG_DIR + '/' + section + '.log';
	let st = fs.stat(path);
	let empty = { lines: [], truncated: false };

	if (!st || st.type != 'file')
		return empty;

	let f = fs.open(path, 'r');

	if (!f)
		return empty;

	let truncated = false;

	if (st.size > LOG_READ_LIMIT) {
		// seek(offset, position) 的 position 是数字: 0=文件开头, 1=当前位置, 2=文件末尾
		f.seek(st.size - LOG_READ_LIMIT, 0);
		truncated = true;
	}

	let data = f.read('all');
	f.close();

	if (data == null)
		return empty;

	let all = split(data, '\n');

	// 去掉尾随空行
	while (length(all) > 0 && trim(all[length(all) - 1]) == '')
		pop(all);

	let start = length(all) - n;

	if (start < 0)
		start = 0;
	else if (start > 0)
		truncated = true;

	let out = [];

	for (let i = start; i < length(all); i++)
		push(out, all[i]);

	return { lines: out, truncated: truncated };
}

// ---------------------------------------------------------------------------
// ubus 对象: ffmpeg
// ---------------------------------------------------------------------------

return {
	ffmpeg: {
		status: {
			call: function() {
				let res = {};
				let names = fs.lsdir(RUN_DIR);

				if (!names)
					return res;

				for (let i = 0; i < length(names); i++) {
					let m = match(names[i], /^([A-Za-z0-9_]+)\.pid$/);

					if (!m)
						continue;

					let info = read_pidfile(m[1]);

					if (!info)
						continue;

					res[m[1]] = {
						running: true,
						pid: info.pid,
						started: info.started
					};
				}

				return res;
			}
		},

		log: {
			args: { section: '', lines: 200 },
			call: function(req) {
				let section = req.args.section;

				if (!valid_section(section))
					return { section: '', lines: [], truncated: false };

				// rpcd 已按 args 声明校验过类型，lines 必定是整数
				let n = req.args.lines;

				if (n == null || n < 1)
					n = 200;

				if (n > MAX_LOG_LINES)
					n = MAX_LOG_LINES;

				let r = read_log(section, n);

				return {
					section: section,
					lines: r.lines,
					truncated: r.truncated
				};
			}
		},

		// 把一组键值直接写进 /etc/config/ffmpeg 并提交。
		//
		// 前端不再自己调 uci.save()：LuCI 的 uci 抽象把改动分成
		// values / changes / creates 三套状态，提交时任何一步不符合预期
		// 都会静默丢失（实测表现为段根本没被创建，转码时才发现配置为空）。
		// 由后端直接落盘，行为完全确定。
		configure: {
			args: { section: '', json: '' },
			call: function(req) {
				let section = req.args.section;

				if (!valid_section(section))
					return { ok: false, error: 'invalid section' };

				/*
				 * 参数以 JSON 字符串传入，而不是 rpcd 的 Table 类型。
				 * Table 走的是 rpcd 的参数编解码，实测出现过字段在传递途中
				 * 丢失的情况（前端发了 9 个，落盘只剩 6 个且分布无规律）。
				 * JSON 字符串只有一种解释方式，不会再有这种不确定性。
				 */
				let vals = null;

				try {
					vals = json(req.args.json);
				}
				catch (e) {
					return { ok: false, error: 'invalid json' };
				}

				if (type(vals) != 'object' || vals == null)
					return { ok: false, error: 'invalid values' };

				let c = cursor();
				c.load('ffmpeg');

				// 段不存在则按 task 类型创建
				if (c.get('ffmpeg', section) == null)
					c.set('ffmpeg', section, 'task');

				let written = 0;
				let keys = [];

				for (let key, val in vals) {
					// 只接受标识符形式的键名，避免写入意外字段
					if (!match(key, /^[A-Za-z0-9_]+$/))
						continue;

					// 空值不写入，否则 UCI 里会留下空选项
					if (val == null || '' + val == '')
						continue;

					c.set('ffmpeg', section, key, '' + val);
					push(keys, key);
					written++;
				}

				c.commit('ffmpeg');

				return { ok: true, section: section, written: written, keys: keys };
			}
		},

		// 探测上传的媒体文件：流编码，以及本机能否解码它。
		//
		// 前端据此提前告知用户「这个源只能复制、不能重编码」，而不是等到
		// 转码失败再让人去猜。实测比查解码器列表可靠：h264 在列表里可能
		// 只有需要 v4l2 设备节点的硬件实现。
		probe: {
			args: { path: '' },
			call: function(req) {
				let path = req.args.path;

				// 限定在 /tmp 下的普通文件名，既避免读取任意文件，也防止命令注入
				if (type(path) != 'string' || !match(path, /^\/tmp\/[A-Za-z0-9_.-]+$/))
					return { ok: false, error: 'invalid path' };

				let p = fs.popen(CTL + " probe '" + path + "' 2>/dev/null");

				if (!p)
					return { ok: false, error: 'probe failed' };

				let out = p.read('all');
				p.close();

				if (out == null)
					return { ok: false, error: 'probe failed' };

				let video = '';
				let audio = '';
				let decodable = false;

				let lines = split(out, '\n');

				for (let i = 0; i < length(lines); i++) {
					let line = trim(lines[i]);

					if (substr(line, 0, 2) == 'V ')
						video = substr(line, 2);
					else if (substr(line, 0, 2) == 'A ')
						audio = substr(line, 2);
					else if (line == 'D yes')
						decodable = true;
				}

				return {
					ok: true,
					video: video,
					audio: audio,
					decodable: decodable
				};
			}
		},

		// 读取某段在 /etc/config/ffmpeg 中的真实内容，用于前端诊断。
		// 直接读文件而不是用 LuCI 的 uci 缓存：缓存里可能只有未提交的变更，
		// 拿它当依据会得出「参数没写进去」这种错误结论。
		config: {
			args: { section: '' },
			call: function(req) {
				let section = req.args.section;

				if (!valid_section(section))
					return { section: '', lines: [] };

				let p = fs.popen(CTL + " show '" + section + "' 2>/dev/null");
				let lines = [];

				if (!p)
					return { section: section, lines: lines };

				let out = p.read('all');
				p.close();

				if (out == null)
					return { section: section, lines: lines };

				let raw = split(out, '\n');

				for (let i = 0; i < length(raw); i++) {
					let v = trim(raw[i]);

					if (length(v) > 0)
						push(lines, v);
				}

				return { section: section, lines: lines };
			}
		},

		// 读取某任务「上一次运行」的退出码。
		// 由 ffmpeg-ctl 的包装进程在 ffmpeg 结束后写入，
		// 前端据此判断成败——比在日志里猜关键词可靠得多。
		exitcode: {
			args: { section: '' },
			call: function(req) {
				let section = req.args.section;

				if (!valid_section(section))
					return { section: '', code: '', known: false };

				let f = fs.open(RUN_DIR + '/' + section + '.exit', 'r');

				if (!f)
					return { section: section, code: '', known: false };

				let line = f.read('line');
				f.close();

				let v = trim(line != null ? line : '');

				// 只接受纯数字（负值表示被信号终止）；code 按字符串返回，前端自行转换
				if (length(v) == 0 || !match(v, /^-?[0-9]+$/))
					return { section: section, code: '', known: false };

				return { section: section, code: v, known: true };
			}
		},

		// 探测本机 ffmpeg 真正可用的编码器，供前端只列出可用的选项。
		//
		// 注意这里调用的是 probe-codecs 而不是 encoders：
		// 编码器出现在 -encoders 列表里不代表能用（h264_v4l2m2m 在虚拟机
		// 上就会报 "Could not find a valid device"），必须实际跑一次才知道。
		encoders: {
			call: function() {
				let p = fs.popen(CTL + ' probe-codecs 2>/dev/null');
				let video = [];
				let audio = [];

				if (!p)
					return { video: video, audio: audio, probed: false };

				let out = p.read('all');
				p.close();

				if (out == null)
					return { video: video, audio: audio, probed: false };

				let lines = split(out, '\n');

				for (let i = 0; i < length(lines); i++) {
					// 形如 "V mpeg4" / "A aac"
					let m = match(lines[i], /^([VA])\s+([A-Za-z0-9_.-]+)/);

					if (!m)
						continue;

					if (m[1] == 'V')
						push(video, m[2]);
					else
						push(audio, m[2]);
				}

				// probed=false 时前端退回列出全部候选，避免探测异常导致无选项可选
				return {
					video: video,
					audio: audio,
					probed: (length(video) > 0 || length(audio) > 0)
				};
			}
		},

		control: {
			args: { action: '', section: '' },
			call: function(req) {
				let action = req.args.action || '';
				let section = req.args.section || '';

				switch (action) {
				case 'start':
				case 'stop':
				case 'restart':
					if (!valid_section(section))
						return { ok: false, code: -1, output: 'invalid section name', running: false };
					break;

				case 'stopall':
					section = '';
					break;

				default:
					return { ok: false, code: -1, output: 'invalid action', running: false };
				}

				let r = exec_ctl(action, section);
				let running = section ? !!read_pidfile(section) : false;
				let ok;

				// proc.close() 返回子进程退出码（被信号终止时为负数），出错时为 null。
				// 万一拿不到退出码，就退回到用真实运行状态判断结果。
				if (r.code == null)
					ok = section ? (action == 'stop' ? !running : running) : true;
				else
					ok = (r.code == 0);

				return {
					ok: ok,
					code: r.code == null ? -1 : r.code,
					output: r.output,
					running: running
				};
			}
		}
	}
};
